# dsh-plugin-ai-bridge — environment fallbacks (all optional; config in
# cordis.patch.yml takes precedence).

# API key for the external model provider (highest-priority fallback)
BRIDGE_API_KEY=

# Provider base URL (OpenAI-compatible URLs include /v1; Anthropic URLs do not)
BRIDGE_BASE_URL=

# Default external model id
BRIDGE_MODEL=

# cc-switch / relay-style variables (reused automatically when BRIDGE_* unset)
OPENAI_BASE_URL=      # OpenAI-compatible relay base (openai / codex / generic)
OPENAI_API_KEY=       # OpenAI-compatible relay token
ANTHROPIC_BASE_URL=   # Anthropic-compatible relay base (anthropic)
ANTHROPIC_AUTH_TOKEN= # Anthropic relay token (takes precedence over ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=    # Anthropic API key
